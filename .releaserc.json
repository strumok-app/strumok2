{
  "branches": [
    "master",
    "main",
    "2.x"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node .github/scripts/prepare-release.mjs ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release-artifacts/app-release.apk",
            "label": "Android APK"
          },
          {
            "path": "release-artifacts/strumok-linux.tar.gz",
            "label": "Linux x64 bundle"
          },
          {
            "path": "release-artifacts/StrumokSetup.exe",
            "label": "Windows x64 installer"
          }
        ]
      }
    ]
  ]
}
